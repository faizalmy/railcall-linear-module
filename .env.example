# ---------------------------------------------------------------------------
# STANDALONE / TEST USE ONLY
# ---------------------------------------------------------------------------
# Inside the RailCall Studio the credential comes from the station vault
# (Sends tab -> "Linear - API key + team"), and the published bundle contains
# no credential environment read at all. This file only matters when you run
# the handlers as a plain Python library or run the test suite.
LINEAR_API_KEY=lin_api_your_key_here

# Optional default team for standalone use. In the Studio this is the team_id
# saved alongside the API key.
# LINEAR_TEAM_ID=00000000-0000-0000-0000-000000000000

# Optional: Redis cache. Without it an in-memory cache is used.
# Requires the optional extra:  pip install -e ".[cache]"
# REDIS_URL=redis://localhost:6379
