# ---------------------------------------------------------------------------
# Generated RailCall bundles
# ---------------------------------------------------------------------------
# Built and Ed25519-signed from handlers/ by tools/build_bundle.py. Never edit
# or commit these: the signature covers the generated bytes, so a hand-edited
# copy is refused by the Studio loader.
#   python3 tools/build_bundle.py                          # readable
#   python3 tools/build_bundle.py --minify --out dist-min  # fits the 100 KiB publish limit
dist/
dist-min/

# ---------------------------------------------------------------------------
# Secrets - never commit
# ---------------------------------------------------------------------------
# .env holds LINEAR_API_KEY. The marketplace publisher keypair lives outside the
# repo at ~/.railcall/marketplace_publisher.json; its seed_hex can sign modules
# as you, so guard against a stray copy landing here.
.env
.env.local
.env.*.local
!.env.example
marketplace_publisher.json
*.pem
*.key

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
var/
sdist/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/
.venv/
.python-version

# ---------------------------------------------------------------------------
# Testing and type-checking caches
# ---------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.dmypy.json
.ruff_cache/

# ---------------------------------------------------------------------------
# Editors and OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
